# deploy/minipc/samplehelp.env.example — шаблон /etc/samplehelp/backend.env
# ЗАПОЛНЯЕТСЯ СЕКРЕТАМИ НА СЕРВЕРЕ (10-install-app.sh генерирует их через
# openssl rand). Права: chown root:samplehelp, chmod 640. В git/дамп НЕ класть!

# --- База ---
# Пароль роли samplehelp генерирует 10-install-app.sh (или задайте свой)
DATABASE_URL=postgres://samplehelp:СМЕНИ_МЕНЯ@127.0.0.1:5432/samplehelp

# --- JWT (секреты 32+ байт; ротация = перегенерировать и перезапустить сервис,
#     все сессии сбросятся — пользователи войдут заново) ---
JWT_SECRET=СМЕНИ_МЕНЯ_openssl_rand_hex_32
REFRESH_SECRET=СМЕНИ_МЕНЯ_openssl_rand_hex_32
ACCESS_TTL=12h
REFRESH_TTL_DAYS=30

# --- Сервер ---
PORT=3100
# В проде статику отдаёт Nginx — STATIC_DIR НЕ задаём (пусто = только API).
STATIC_DIR=
STORAGE_DIR=/var/lib/samplehelp/storage
UPLOAD_LIMIT_MB=25
LIFECYCLE_MS=600000
AUTH_RATE_MAX=20

# --- Публичный адрес сайта (ссылки в письмах, OG) ---
PUBLIC_URL=https://ВАШ-ДОМЕН.ru

# --- SMTP (сброс пароля). Без него ссылка печатается в журнал сервиса
#     (journalctl -u samplehelp-backend) — для dev достаточно. ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SampleHelp <no-reply@ВАШ-ДОМЕН.ru>
