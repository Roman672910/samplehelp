{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "backend: сервер (:3100)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "backend: realtime-демо (проверка пушей)",
      "program": "${workspaceFolder}/backend/tools/realtime-demo.mjs",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "backend: живой смоук Фазы C (api.mjs)",
      "program": "${workspaceFolder}/backend/tools/phase_c_smoke.mjs",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "backend: тесты Фаз A+B+C",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "test"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "backend: миграция схемы",
      "program": "${workspaceFolder}/backend/src/migrate.js",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    }
